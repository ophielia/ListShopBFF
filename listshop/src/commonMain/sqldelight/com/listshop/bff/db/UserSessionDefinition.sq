CREATE TABLE UserInfoEntity (
    userName TEXT,
    userToken TEXT,
    userInfoCreated TEXT,
    userLastSeen TEXT,
    userLastSignedIn TEXT,
    userCreatedOnServer TEXT
);

insertIntoUserInfo:
INSERT INTO UserInfoEntity(userName, userToken, userInfoCreated, userLastSeen, userLastSignedIn , userCreatedOnServer)
VALUES (?, ?,?,?,?, ?);


updateUserInfo:
UPDATE UserInfoEntity
  SET userName = ?,
      userToken = ?,
      userInfoCreated = ?,
      userLastSeen = ?,
      userLastSignedIn = ?,
      userCreatedOnServer = ?;

selectAllUserInfos:
SELECT UserInfoEntity.* FROM UserInfoEntity;

removeAllUserInfo:
DELETE FROM UserInfoEntity;


CREATE TABLE ListInfoEntity (
    lastInternalUpdate TEXT,
    lastUpdate TEXT,
    localListUpdated TEXT,
    serverListId TEXT,
    lookupDataLastSynced TEXT,
    statisticsLastSynced TEXT,
    localLastSynced TEXT,
    serverListLastSynced TEXT
);

insertIntoListInfo:
INSERT INTO ListInfoEntity(lastInternalUpdate , lastUpdate , localListUpdated , serverListId , lookupDataLastSynced , statisticsLastSynced , localLastSynced , serverListLastSynced)
VALUES (?, ?, ?, ?, ?, ?, ?, ? );

updateListInfo:
UPDATE ListInfoEntity
  SET lastInternalUpdate = ?,
      lastUpdate = ?,
      localListUpdated = ?,
      serverListId = ?,
      lookupDataLastSynced = ?,
      statisticsLastSynced = ?,
      localLastSynced = ?,
      serverListLastSynced = ?;


selectAllListInfos:
SELECT ListInfoEntity.* FROM ListInfoEntity;

removeAllListInfo:
DELETE FROM ListInfoEntity;

CREATE TABLE UserPropertiesEntity (
    key TEXT,
    property_value TEXT
);

insertIntoUserProperties:
INSERT INTO UserPropertiesEntity(key, property_value )
VALUES (?, ?);


removeAllUserProperties:
DELETE FROM UserPropertiesEntity;

deleteUserPropertyByKey:
DELETE FROM UserPropertiesEntity WHERE key = ?;

selectAllUserProperties:
SELECT UserPropertiesEntity.* FROM UserPropertiesEntity;
