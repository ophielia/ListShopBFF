import kotlin.Boolean;
import kotlin.Int;

CREATE TABLE ShoppingListEntity (
    name TEXT,
    externalId TEXT,
    createdOn TEXT,
    updatedOn TEXT,
    lastLocalChange TEXT,
    lastSync TEXT,
    itemCount INTEGER AS Int,
    layoutId TEXT,
    isStarter  INTEGER AS Boolean NOT NULL
);


CREATE TABLE ListCategoryEntity (
    name TEXT,
    externalId TEXT,
    listExternalId TEXT,
    displayOrder INTEGER AS Int
);

CREATE TABLE ListItemEntity (
    externalId TEXT,
    categoryExternalId TEXT,
    tagExternalId TEXT,
    added TEXT,
    removed TEXT,
    updatedOn TEXT,
    crossedOff TEXT,
    usedCount INTEGER AS Int,
    tagName TEXT,
    quantity REAL,
    wholeQuantity INTEGER AS Int,
    roundedQuantity REAL,
    quantityDisplay TEXT,
    unitId TEXT,
    unitDisplay TEXT,
    amountDisplay TEXT,
    tagType TEXT,
    legendKeys TEXT
);

CREATE TABLE ListItemDetailEntity (
    itemExternalId TEXT,
    dishId TEXT,
    listId TEXT,
    containsUnspecified INTEGER AS Boolean NOT NULL,
    quantity REAL,
    wholeQuantity INTEGER AS Int,
    roundedQuantity REAL,
    quantityDisplay TEXT,
    unitId TEXT,
    unitDisplay TEXT,
    amountDisplay TEXT
);

insertIntoShoppingListEntity:
INSERT INTO ShoppingListEntity(name,externalId,createdOn,updatedOn,lastLocalChange,lastSync,itemCount,layoutId  , isStarter)
VALUES (?,?,?,?, ?, ?, ?, ?, ?);

insertIntoListCategoryEntity:
INSERT INTO ListCategoryEntity(name, externalId, listExternalId, displayOrder)
VALUES (?, ?, ?, ?);

insertIntoListItemEntity:
INSERT INTO ListItemEntity(externalId, categoryExternalId, tagExternalId, added, removed, crossedOff,updatedOn, usedCount, tagName, quantity, wholeQuantity, roundedQuantity, quantityDisplay, unitId, unitDisplay, amountDisplay, tagType, legendKeys)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertIntoListItemDetailEntity:
INSERT INTO ListItemDetailEntity(itemExternalId, dishId, listId, containsUnspecified, quantity, wholeQuantity, roundedQuantity, quantityDisplay, unitId, unitDisplay, amountDisplay)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

removeAllShoppingListEntities:
DELETE FROM ShoppingListEntity;

removeAllListCategoryEntities:
DELETE FROM ListCategoryEntity;

removeAllListItemEntities:
DELETE FROM ListItemEntity;

removeAllListItemDetailEntities:
DELETE FROM ListItemDetailEntity;

removeAllData:
DELETE FROM ShoppingListEntity;
DELETE FROM ListCategoryEntity;
DELETE FROM ListItemEntity;
DELETE FROM ListItemDetailEntity;

selectAllLists:
SELECT ShoppingListEntity.*
FROM ShoppingListEntity;

selectAllCategoriesForList:
SELECT *
FROM ListCategoryEntity
WHERE listExternalId = ?;

selectAllItemsForCategory:
SELECT *
FROM ListItemEntity
WHERE categoryExternalId = ?;

selectAllDetailsForCategory:
SELECT *
FROM ListItemDetailEntity
JOIN ListItemEntity ON ListItemEntity.externalId = ListItemDetailEntity.itemExternalId
WHERE ListItemEntity.categoryExternalId = ?;


updateListId:
UPDATE ShoppingListEntity
SET externalId = ?;



