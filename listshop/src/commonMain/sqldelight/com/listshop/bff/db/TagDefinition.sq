import kotlin.Boolean;

CREATE TABLE TagEntity (
    externalId TEXT,
    isGroup INTEGER AS Boolean NOT NULL,
    name TEXT,
    parentId TEXT,
    power TEXT,
    tagType TEXT,
    userId TEXT

);

insertIntoTag:
INSERT INTO TagEntity(externalId, isGroup, name, parentId, power, tagType, userId)
VALUES (?,?,?,?,?,?,?);


removeAllTags:
DELETE FROM TagEntity;

selectAllTags:
SELECT TagEntity.*
FROM TagEntity;

selectTagsByTagTypes:
SELECT *
FROM TagEntity
WHERE tagType IN ?;
